<Project Sdk="Microsoft.NET.Sdk">
  <!-- ShaftMaster.exe (WPF, x64). It does not reference the STEP worker: the worker is a separate process that the solution
       builds into the same folder (solution dependency); CheckStepExportWorker fails the build if it is missing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShaftMaster</AssemblyName>
    <RootNamespace>Elevator.Solution.Desktop</RootNamespace>
    <StartupObject>Elevator.Solution.Desktop.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon and the mark are generated by tools/BrandIconBuilder into <output>/brand-assets (target BrandAssets). -->
    <BrandAssetsDir>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))brand-assets\</BrandAssetsDir>
    <ApplicationIcon>$(BrandAssetsDir)ShaftMaster.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="..\Elevator.Core\Elevator.Core.csproj" />
    <ProjectReference Include="..\Elevator.Solution.Bridge\Elevator.Solution.Bridge.csproj" />
    <ProjectReference Include="..\Elevator.Reporting\Elevator.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(BrandAssetsDir)ShaftMasterLogo.png" LogicalName="ShaftMaster.Assets.ShaftMasterLogo.png" />
    <EmbeddedResource Include="$(BrandAssetsDir)ShaftMasterMark.png" LogicalName="ShaftMaster.Assets.ShaftMasterMark.png" />
    <BrandSource Include="Assets\*" />
    <!-- Data and documents next to the application, as the csc build copied them. -->
    <None Include="..\examples\ElevatorProject.example.json" Link="reviewed-example.elevator.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\config\reviewed-context.json" Link="reviewed-context.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\config\reviewed-chassis-evidence.json" Link="reviewed-chassis-evidence.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\config\presets.json" Link="presets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\config\preliminary-3d-reference.json" Link="preliminary-3d-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\architecture\STEP-EXPORT.md" Link="STEP-EXPORT.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\releases\SHAFTMASTER-UI-RESULTS.md" Link="SHAFTMASTER-UI-RESULTS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Brand assets: copy Assets/ to <output>/brand-assets and generate ShaftMaster.ico and ShaftMasterMark.png there with
       tools/BrandIconBuilder (built first through the solution dependency); runs only when an asset or the tool changed. -->
  <Target Name="BrandAssets" BeforeTargets="BeforeBuild" Inputs="@(BrandSource);$(OutDir)BrandIconBuilder.exe" Outputs="$(BrandAssetsDir)ShaftMaster.ico">
    <Error Condition="!Exists('$(OutDir)BrandIconBuilder.exe')" Text="tools/BrandIconBuilder is not built in $(OutDir). Build the solution (tools/build.ps1)." />
    <Copy SourceFiles="@(BrandSource)" DestinationFolder="$(BrandAssetsDir)" />
    <Exec Command="&quot;$(OutDir)BrandIconBuilder.exe&quot; &quot;$(BrandAssetsDir.TrimEnd('\'))&quot;" />
    <Touch Files="$(BrandAssetsDir)ShaftMaster.ico" />
  </Target>
  <Target Name="CheckStepExportWorker" AfterTargets="Build" Condition="'$(BuildingSolutionFile)' == 'true'">
    <Error Condition="!Exists('$(OutDir)Elevator.Solution.StepExport.exe')" Text="The STEP worker Elevator.Solution.StepExport.exe is not next to ShaftMaster.exe in $(OutDir). Build the solution (tools/build.ps1)." />
  </Target>
</Project>