<Project Sdk="Microsoft.NET.Sdk">
  <!-- SOLIDWORKS STEP worker, launched by ShaftMaster as a separate process. The interop assemblies come from
       $(SolidWorksDir) and are copied next to it, as before. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Elevator.Solution.StepExport</AssemblyName>
    <RootNamespace>Elevator.Solution.StepExport</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SolidWorksDir)\SolidWorks.Interop.sldworks.dll</HintPath><Private>true</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SolidWorksDir)\SolidWorks.Interop.swconst.dll</HintPath><Private>true</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <ProjectReference Include="..\Elevator.Core\Elevator.Core.csproj" />
    <ProjectReference Include="..\Elevator.Solution.Bridge\Elevator.Solution.Bridge.csproj" />
  </ItemGroup>
  <Target Name="CheckSolidWorksInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(SolidWorksDir)\SolidWorks.Interop.sldworks.dll') Or !Exists('$(SolidWorksDir)\SolidWorks.Interop.swconst.dll')">
    <Error Text="STEP build dependency missing: the SOLIDWORKS interop assemblies are not in $(SolidWorksDir). Pass -SolidWorksDir to tools/build.ps1." />
  </Target>
</Project>