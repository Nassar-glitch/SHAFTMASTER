<Project Sdk="Microsoft.NET.Sdk">
  <!-- AutoCAD Core Console entry point ($(AutoCADDir)); the AutoCAD assemblies are not copied. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Elevator.Solution.Host</AssemblyName>
    <RootNamespace>Elevator.Solution.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\Elevator.Core\Elevator.Core.csproj" />
    <ProjectReference Include="..\Elevator.Solution.Bridge\Elevator.Solution.Bridge.csproj" />
    <ProjectReference Include="..\Elevator.AutoCAD\Elevator.AutoCAD.csproj" />
  </ItemGroup>
</Project>