<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier-1 xUnit tests of Elevator.Core (ARCHITECTURE-PLAN P2), net8.0 (netstandard2.0 Core, JavaScriptCompatibleJson)
       and net48 (the application's Core, JavaScriptSerializer). -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code only: the shipped assemblies stay C# 5. -->
    <LangVersion>latest</LangVersion>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <!-- The hosted console suites have their own Main methods. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <OutDir>$(ArtifactsRoot)tests\Elevator.Core.Tests\$(TargetFramework)\</OutDir>
    <NoWarn>$(NoWarn);CS0618;xUnit1013</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <StartupObject>Elevator.Core.Tests.TestHost</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="..\..\Elevator.Core\Elevator.Core.csproj" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF-free application sources used by the Core suites, and the golden JSON member sort. -->
    <Compile Include="..\..\Elevator.Solution.Desktop\CalculationWorkspace.cs" Link="Linked\CalculationWorkspace.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\ProjectSession.cs" Link="Linked\ProjectSession.cs" />
    <Compile Include="..\golden\JsonMembers.cs" Link="Linked\JsonMembers.cs" />
    <!-- The console suites, run unchanged inside xUnit (the console runners stay until P7). -->
    <Compile Include="..\solution\RopeTractionTests.cs" Link="Suites\RopeTractionTests.cs" />
    <Compile Include="..\solution\CarGuideForceTests.cs" Link="Suites\CarGuideForceTests.cs" />
    <Compile Include="..\solution\SafetyPitTests.cs" Link="Suites\SafetyPitTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <ProjectReference Include="..\..\Elevator.Solution.Bridge\Elevator.Solution.Bridge.csproj" Private="true" />
    <!-- PresetsTests needs the Design Notes, which need the calculation-sheet sources (WPF figures): .NET Framework only. -->
    <Compile Include="..\solution\PresetsTests.cs" Link="Suites\PresetsTests.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\CalculationSheet.cs" Link="Linked\CalculationSheet.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\CalculationSheetRopes.cs" Link="Linked\CalculationSheetRopes.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\CalculationFiguresRopes.cs" Link="Linked\CalculationFiguresRopes.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\DesignNotes.cs" Link="Linked\DesignNotes.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\DocxWriter.cs" Link="Linked\DocxWriter.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\CompanyReportSettings.cs" Link="Linked\CompanyReportSettings.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\FigureModel.cs" Link="Linked\FigureModel.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\FigureRender.cs" Link="Linked\FigureRender.cs" />
    <Compile Include="..\..\Elevator.Solution.Desktop\CalculationFigures.cs" Link="Linked\CalculationFigures.cs" />
  </ItemGroup>
</Project>
