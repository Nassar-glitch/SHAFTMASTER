<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native drawing adapter for AutoCAD 2023 ($(AutoCADDir)); the AutoCAD assemblies are not copied. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Elevator.AutoCAD</AssemblyName>
    <RootNamespace>Elevator.AutoCAD</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\Elevator.Core\Elevator.Core.csproj" />
  </ItemGroup>
</Project>